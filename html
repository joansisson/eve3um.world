<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EvE3UM Software — Product Showcase</title>
  <style>
    :root {
      --bg-color: #f7f6f3; /* Notion-like warm background */
      --card-bg: #ffffff;
      --text-main: #37352f;
      --text-muted: #787774;
      --accent-color: #2eaadc;
      --border-color: #e9e9e7;
      --radius: 12px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      padding: 0 0 32px 0; /* Padding moved to bottom to let banner stretch */
    }

    /* Top Hero Banner */
    .banner {
      background: #0b0b12;
      text-align: center;
      margin-bottom: 32px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .banner-link {
      display: block;
      line-height: 0;
    }

    .banner-img {
      display: block;
      width: 100%;
      height: auto; /* Full natural height — no cropping */
      transition: opacity 0.2s ease;
    }

    .banner-link:hover .banner-img {
      opacity: 0.92;
    }

    .banner-cta {
      padding: 20px 24px 28px;
    }

    .banner-btn {
      display: inline-block;
      background-color: #ffffff;
      color: #0b0b12;
      font-weight: 700;
      padding: 12px 26px;
      border-radius: 8px;
      text-decoration: none;
      font-size: 0.95rem;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .banner-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 16px rgba(255, 255, 255, 0.15);
    }

    /* Main Container */
    .container {
      padding: 0 24px;
      max-width: 1200px;
      margin: 0 auto;
    }

    /* Product Grid Layout */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 20px;
    }

    /* Product Card */
    .card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: var(--radius);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
    }

    .thumbnail-container {
      width: 100%;
      height: 180px;
      background-color: #eee;
      overflow: hidden;
      position: relative;
    }

    .thumbnail-container img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Dark, contain-fit thumbnail (e.g. logos on dark backgrounds) */
    .thumbnail-container.dark {
      background-color: #141414;
    }

    .thumbnail-container.contain img {
      object-fit: contain;
    }

    .card-body {
      padding: 16px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .badge {
      align-self: flex-start;
      background-color: rgba(46, 170, 220, 0.1);
      color: var(--accent-color);
      font-size: 0.75rem;
      font-weight: 600;
      padding: 4px 8px;
      border-radius: 4px;
      margin-bottom: 8px;
    }

    .product-title {
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 6px;
    }

    .product-desc {
      font-size: 0.875rem;
      color: var(--text-muted);
      line-height: 1.4;
      margin-bottom: 16px;
      flex-grow: 1;
    }

    .card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 12px;
      border-top: 1px solid var(--border-color);
    }

    .price {
      font-weight: 700;
      font-size: 1.05rem;
    }

    .btn {
      display: inline-block;
      background-color: var(--text-main);
      color: #fff;
      text-decoration: none;
      padding: 8px 14px;
      border-radius: 6px;
      font-size: 0.825rem;
      font-weight: 500;
      transition: background 0.2s ease;
    }

    .btn:hover {
      background-color: #000;
    }
  </style>
</head>
<body>

  <!-- Top Hero Banner -->
  <header class="banner">
    <a href="https://joansisson.github.io/EvE3UM/html" class="banner-link" target="_blank" rel="noopener">
      <img src="assets/EvE3UM Banner2.png" alt="EvE3UM Software — Problem → Plan → Executed → Solution" class="banner-img">
